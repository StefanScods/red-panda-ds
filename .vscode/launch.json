    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/redPandaDS${env:OS:exe}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/stefan/scoop/apps/mingw/current/bin/gdb.exe", // TODO!!! make gdb more flexible
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build (Ninja Debug)"
        }


    ]
}